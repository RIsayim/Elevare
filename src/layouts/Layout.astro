---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Solace — Integrated Living', description = 'Thoughtful technology for the way you want to live.' } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#e8e5df" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduceMotion) {
				let targetScrollY = window.scrollY;
				let scrollFrame = 0;
				const root = document.documentElement;

				const stopWheelScroll = () => {
					if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
					scrollFrame = 0;
					targetScrollY = window.scrollY;
					root.style.scrollBehavior = '';
				};

				const animateWheelScroll = () => {
					const currentY = window.scrollY;
					const distance = targetScrollY - currentY;
					if (Math.abs(distance) < 0.8) {
						window.scrollTo(0, targetScrollY);
						scrollFrame = 0;
						root.style.scrollBehavior = '';
						return;
					}
					window.scrollTo(0, currentY + distance * 0.12);
					scrollFrame = window.requestAnimationFrame(animateWheelScroll);
				};

				window.addEventListener('wheel', (event) => {
					if (event.ctrlKey || Math.abs(event.deltaY) < 0.01 || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
					if (event.target instanceof Element && event.target.closest('textarea, select, input, [contenteditable="true"]')) return;
					event.preventDefault();
					const deltaScale = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? window.innerHeight : 1;
					const baseY = scrollFrame ? targetScrollY : window.scrollY;
					const maxScrollY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
					targetScrollY = Math.min(maxScrollY, Math.max(0, baseY + event.deltaY * deltaScale));
					root.style.scrollBehavior = 'auto';
					if (!scrollFrame) scrollFrame = window.requestAnimationFrame(animateWheelScroll);
				}, { passive: false });

				window.addEventListener('pointerdown', stopWheelScroll, true);
				window.addEventListener('touchstart', stopWheelScroll, { passive: true });
				window.addEventListener('keydown', stopWheelScroll, true);
			}
		</script>
	</body>
</html>
