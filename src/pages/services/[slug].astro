---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services } from '../../data/services';
import { withBase } from '../../utils/site-path';

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<Layout title={`${service.name} — Solace Integrated Living`} description={service.intro}>
	<SiteHeader />
	<main class:list={["service-detail-page", service.slug === 'security-cameras' && 'service-detail-page--security']}>
		<section class:list={["service-detail-hero", service.slug === 'security-cameras' && 'service-detail-hero--security']} aria-labelledby="service-detail-title" data-service-hero>
			<figure class:list={["service-detail-image", service.slug === 'security-cameras' && 'service-detail-image--security']} style={`--service-hero-background: url("${service.heroImage}")`}>
				<img src={service.heroImage} alt={service.heroImageAlt} fetchpriority="high" />
				<div class="service-detail-image-shade" aria-hidden="true"></div>
			</figure>
			<h1 id="service-detail-title" class="service-detail-title">
				{service.heroTitleLines.map((line) => <span>{line}</span>)}
			</h1>
			{service.slug !== 'security-cameras' && <a class="service-detail-down" href="#service-detail-content" aria-label={`Explore ${service.name}`}>
				<svg viewBox="0 0 42 64" aria-hidden="true" focusable="false"><path d="M21 2v57M3 42l18 18 18-18" /></svg>
			</a>}
		</section>

		<section class:list={["service-detail-story", service.slug === 'security-cameras' && 'service-detail-story--security']} aria-labelledby="service-detail-story-title">
			<figure class="service-detail-story-image">
				<img src={service.featureImage} alt={service.featureImageAlt} loading="lazy" decoding="async" />
			</figure>
			<div class="service-detail-story-copy">
				<h2 id="service-detail-story-title">{service.featureTitle}</h2>
				<p>{service.featureText}</p>
			</div>
		</section>

		<section class="service-detail-video" aria-label={`${service.name} video`}>
			<figure class="service-detail-video-frame">
				<video autoplay muted loop playsinline preload="metadata" poster={service.featureImage} aria-label={`${service.name} in a contemporary home`}>
					<source src={service.serviceVideo} type="video/mp4" />
				</video>
			</figure>
		</section>

		{service.imagePair && <section class="service-detail-image-pair scroll-reveal" aria-label={`${service.name} in the home`} data-service-image-pair>
			{service.imagePair.map((image, index) => (
				<figure class:list={["service-detail-image-pair-item", `service-detail-image-pair-item--${index + 1}`]}>
					<img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
				</figure>
			))}
		</section>}

		{service.slug === 'security-cameras' && <section class="project-story service-detail-security-story" aria-labelledby="security-story-title">
			<div class="project-story-inner">
				<h2 id="security-story-title">CONFIDENCE, WITHOUT COMPROMISING THE HOME.</h2>
				<div class="project-story-copy">
					<p>Security is most effective when it feels quietly present. We shape coverage around the ways a home is entered and used, bringing cameras, access, and alerts together with care for its architecture.</p>
					<p>Thoughtful placement helps make arrival feel natural, keeps important outdoor areas in view, and gives homeowners a clearer sense of what is happening while they are away. The technology stays easy to reach and out of the way.</p>
				</div>
			</div>
		</section>}

		<section class="service-detail-benefits" id="service-detail-content" aria-labelledby="service-detail-benefits-title">
			<div class="service-detail-benefits-heading">
				<p class="service-detail-kicker">Designed around your home</p>
				<h2 id="service-detail-benefits-title">{service.statement}</h2>
				<p class="service-detail-intro">{service.intro}</p>
				<a class="service-detail-link" href={withBase('/consultation/')}>Discuss your home <span aria-hidden="true">↗</span></a>
			</div>
			<div class="service-detail-benefit-list">
				{service.benefits.map((benefit, index) => (
					<article class="service-detail-benefit">
						<p class="service-detail-benefit-number">0{index + 1}</p>
						<div>
							<h3>{benefit.title}</h3>
							<p>{benefit.text}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="service-detail-cta" aria-label="Start a conversation about your home">
			<p>Every home has its own character. Let’s shape a solution around yours.</p>
			<a class="service-detail-link" href={withBase('/consultation/')}>Start a conversation <span aria-hidden="true">↗</span></a>
		</section>
	</main>
	<SiteFooter showIntro={false} />
</Layout>

<script>
	const serviceHero = document.querySelector<HTMLElement>('[data-service-hero]');
	const siteHeader = document.querySelector<HTMLElement>('.site-header');
	if (serviceHero && siteHeader) {
		const updateHeaderContrast = () => {
			const headerBottom = siteHeader.getBoundingClientRect().bottom;
			const heroBounds = serviceHero.getBoundingClientRect();
			const overHero = heroBounds.top <= headerBottom && heroBounds.bottom >= headerBottom;
			siteHeader.classList.toggle('is-over-service', overHero && !document.body.classList.contains('menu-open'));
		};
		updateHeaderContrast();
		window.addEventListener('scroll', updateHeaderContrast, { passive: true });
		window.addEventListener('resize', updateHeaderContrast);
		const menuToggle = document.querySelector('.menu-toggle');
		menuToggle?.addEventListener('click', () => requestAnimationFrame(updateHeaderContrast));
	}
	const serviceImagePair = document.querySelector<HTMLElement>('[data-service-image-pair]');
	const servicePairImages = serviceImagePair?.querySelectorAll<HTMLElement>('.service-detail-image-pair-item');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (serviceImagePair && servicePairImages?.length === 2 && !reduceMotion && window.matchMedia('(min-width: 801px)').matches) {
		let pairFrame = 0;
		const updateServiceImagePair = () => {
			pairFrame = 0;
			const bounds = serviceImagePair.getBoundingClientRect();
			const progress = Math.min(1, Math.max(0, (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height)));
			const travel = (0.5 - progress) * Math.min(110, window.innerHeight * 0.14);
			servicePairImages[0].style.setProperty('--service-pair-y', `${travel.toFixed(1)}px`);
			servicePairImages[1].style.setProperty('--service-pair-y', `${(-travel).toFixed(1)}px`);
		};
		const requestPairUpdate = () => {
			if (!pairFrame) pairFrame = window.requestAnimationFrame(updateServiceImagePair);
		};
		window.addEventListener('scroll', requestPairUpdate, { passive: true });
		window.addEventListener('resize', requestPairUpdate, { passive: true });
		updateServiceImagePair();
	}
</script>
