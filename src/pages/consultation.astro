---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Consultation — Solace Integrated Living" description="Book a thoughtful first conversation with Solace about your home.">
  <SiteHeader />
  <main class="consultation-page">
    <section class="hero consultation-hero" aria-labelledby="consultation-hero-title">
      <div class="hero-copy consultation-hero-copy">
        <h1 id="consultation-hero-title">Let&rsquo;s shape a home<br />that feels like you.</h1>
      </div>
    </section>

    <section class="consultation-booking" aria-labelledby="consultation-meet-title">
      <div class="consultation-booking-layout">
        <figure class="consultation-booking-image">
          <video class="consultation-booking-video" poster="/images/solace-hero.webp" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
            <source src="/videos/solace-hero.mp4" type="video/mp4" />
          </video>
          <figcaption><span>Solace Integrated Living</span><span>Technology, quietly considered</span></figcaption>
        </figure>

        <form class="consultation-calendar" data-booking-form>
          <div class="consultation-calendar-topline">
            <div>
              <h3 id="consultation-meet-title">Choose a way to meet</h3>
            </div>
          </div>

          <div class="meeting-types" role="group" aria-label="Appointment type">
            <button type="button" class="meeting-type" data-meeting-type="Studio visit" aria-pressed="false">Studio visit</button>
            <button type="button" class="meeting-type is-active" data-meeting-type="Project call" aria-pressed="true">Project call</button>
          </div>

          <div class="calendar-controls">
            <h4 data-calendar-month aria-live="polite"></h4>
            <div class="calendar-nav">
              <button type="button" data-calendar-prev aria-label="Previous month">&larr;</button>
              <button type="button" data-calendar-next aria-label="Next month">&rarr;</button>
            </div>
          </div>
          <div class="calendar-weekdays" aria-hidden="true">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
          </div>
          <div class="calendar-days" data-calendar-days role="group" aria-label="Choose an available date"></div>

          <div class="calendar-selection" data-calendar-selection aria-live="polite">
            <p>Select a date to see available times.</p>
          </div>
          <div class="calendar-time-slots" data-calendar-slots role="group" aria-label="Available appointment times" hidden></div>

          <div class="booking-details" data-booking-details hidden>
            <div class="booking-summary" data-booking-summary></div>
            <div class="booking-fields">
              <div>
                <label for="booking-name">Your name <span>*</span></label>
                <input id="booking-name" name="name" autocomplete="name" required />
              </div>
              <div>
                <label for="booking-email">Email address <span>*</span></label>
                <input id="booking-email" name="email" type="email" autocomplete="email" required />
              </div>
            </div>
          </div>

          <div class="calendar-submit-row">
            <p>We&rsquo;ll confirm availability by email.</p>
            <button class="calendar-submit" type="submit" data-booking-submit disabled>Request a time <span aria-hidden="true">&rarr;</span></button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter showIntro={false} />

  <script>
    const bookingForm = document.querySelector<HTMLFormElement>('[data-booking-form]');
    const monthHeading = document.querySelector<HTMLElement>('[data-calendar-month]');
    const calendarDays = document.querySelector<HTMLElement>('[data-calendar-days]');
    const previousMonth = document.querySelector<HTMLButtonElement>('[data-calendar-prev]');
    const nextMonth = document.querySelector<HTMLButtonElement>('[data-calendar-next]');
    const timeSlotList = document.querySelector<HTMLElement>('[data-calendar-slots]');
    const datePrompt = document.querySelector<HTMLElement>('[data-calendar-selection]');
    const bookingDetails = document.querySelector<HTMLElement>('[data-booking-details]');
    const bookingSummary = document.querySelector<HTMLElement>('[data-booking-summary]');
    const bookingSubmit = document.querySelector<HTMLButtonElement>('[data-booking-submit]');
    const meetingTypeButtons = document.querySelectorAll<HTMLButtonElement>('[data-meeting-type]');

    let visibleMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    let selectedDate = '';
    let selectedTime = '';
    let meetingType = 'Project call';

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const formatDate = (dateString: string) => new Intl.DateTimeFormat('en-US', {
      weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
    }).format(new Date(`${dateString}T12:00:00`));

    const clearTimeSelection = () => {
      selectedTime = '';
      if (timeSlotList) {
        timeSlotList.hidden = true;
        timeSlotList.replaceChildren();
      }
      if (bookingDetails) bookingDetails.hidden = true;
      if (bookingSubmit) bookingSubmit.disabled = true;
    };

    const animateBookingUpdate = (update: () => void) => {
      if (!bookingForm || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        update();
        return;
      }
      bookingForm.getAnimations().forEach((animation) => animation.cancel());
      const startHeight = bookingForm.getBoundingClientRect().height;
      update();
      const endHeight = bookingForm.getBoundingClientRect().height;
      if (Math.abs(endHeight - startHeight) < 2) return;
      bookingForm.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 520, easing: 'cubic-bezier(.22,.61,.36,1)' },
      );
    };

    const renderCalendar = () => {
      if (!monthHeading || !calendarDays) return;
      monthHeading.textContent = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(visibleMonth);
      const year = visibleMonth.getFullYear();
      const month = visibleMonth.getMonth();
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      calendarDays.replaceChildren();

      for (let blank = 0; blank < firstWeekday; blank += 1) {
        const emptyCell = document.createElement('span');
        emptyCell.className = 'calendar-day calendar-day-empty';
        emptyCell.setAttribute('aria-hidden', 'true');
        calendarDays.append(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = new Date(year, month, day);
        const isoDate = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const unavailable = date < today || date.getDay() === 0 || date.getDay() === 6;
        const dateButton = document.createElement('button');
        dateButton.type = 'button';
        dateButton.className = `calendar-day${unavailable ? ' is-unavailable' : ''}${selectedDate === isoDate ? ' is-selected' : ''}`;
        dateButton.textContent = String(day);
        dateButton.setAttribute('aria-label', formatDate(isoDate));
        dateButton.setAttribute('aria-pressed', String(selectedDate === isoDate));
        dateButton.dataset.selectDate = isoDate;
        dateButton.disabled = unavailable;
        calendarDays.append(dateButton);
      }

      if (previousMonth) previousMonth.disabled = year === today.getFullYear() && month <= today.getMonth();
    };

    calendarDays?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement) || !target.dataset.selectDate) return;
      animateBookingUpdate(() => {
        selectedDate = target.dataset.selectDate || '';
        clearTimeSelection();
        renderCalendar();
        if (datePrompt) datePrompt.innerHTML = `<p>Available times for <strong>${formatDate(selectedDate)}</strong></p>`;
        if (!timeSlotList) return;
        timeSlotList.hidden = false;
        ['10:00 AM', '1:30 PM', '4:00 PM'].forEach((time) => {
          const timeButton = document.createElement('button');
          timeButton.type = 'button';
          timeButton.className = 'calendar-time';
          timeButton.textContent = time;
          timeButton.dataset.selectTime = time;
          timeButton.setAttribute('aria-pressed', 'false');
          timeSlotList.append(timeButton);
        });
      });
    });

    timeSlotList?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement) || !target.dataset.selectTime) return;
      animateBookingUpdate(() => {
        selectedTime = target.dataset.selectTime || '';
        timeSlotList.querySelectorAll<HTMLButtonElement>('[data-select-time]').forEach((button) => {
          button.classList.toggle('is-selected', button === target);
          button.setAttribute('aria-pressed', String(button === target));
        });
        if (bookingDetails) bookingDetails.hidden = false;
        if (bookingSummary) bookingSummary.textContent = `${formatDate(selectedDate)} · ${selectedTime} · ${meetingType}`;
        if (bookingSubmit) bookingSubmit.disabled = false;
      });
    });

    meetingTypeButtons.forEach((button) => button.addEventListener('click', () => {
      meetingType = button.dataset.meetingType || 'Project call';
      meetingTypeButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      if (bookingSummary && selectedTime) bookingSummary.textContent = `${formatDate(selectedDate)} · ${selectedTime} · ${meetingType}`;
    }));

    previousMonth?.addEventListener('click', () => {
      animateBookingUpdate(() => {
        visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
        selectedDate = '';
        clearTimeSelection();
        if (datePrompt) datePrompt.innerHTML = '<p>Select a date to see available times.</p>';
        renderCalendar();
      });
    });
    nextMonth?.addEventListener('click', () => {
      animateBookingUpdate(() => {
        visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
        selectedDate = '';
        clearTimeSelection();
        if (datePrompt) datePrompt.innerHTML = '<p>Select a date to see available times.</p>';
        renderCalendar();
      });
    });

    renderCalendar();
    bookingForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!bookingForm.reportValidity() || !selectedDate || !selectedTime) return;
      const values = new FormData(bookingForm);
      const subject = encodeURIComponent(`Solace ${meetingType.toLowerCase()} request — ${String(values.get('name') || '')}`);
      const body = encodeURIComponent([
        `Name: ${values.get('name') || ''}`,
        `Email: ${values.get('email') || ''}`,
        `Meeting type: ${meetingType}`,
        `Preferred date: ${formatDate(selectedDate)}`,
        `Preferred time: ${selectedTime}`,
        '',
        'Please confirm availability for this appointment request.',
      ].join('\n'));
      window.location.href = `mailto:hello@solace.studio?subject=${subject}&body=${body}`;
    });
  </script>
</Layout>
